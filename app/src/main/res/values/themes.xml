<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NovaUpload" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/nova_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/nova_surface</item>
        <item name="android:statusBarColor">@color/nova_bg</item>
        <item name="android:navigationBarColor">@color/nova_surface</item>
        <item name="android:windowBackground">@color/nova_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">@font/yekanbakh</item>
        <item name="fontFamily">@font/yekanbakh</item>
        <item name="android:textViewStyle">@style/Widget.Nova.TextView</item>
        <item name="materialButtonStyle">@style/Widget.Nova.Button</item>
        <item name="textInputStyle">@style/Widget.Nova.TextInput</item>
        <item name="materialAlertDialogTheme">@style/Theme.NovaUpload.Dialog</item>
    </style>

    <style name="Widget.Nova.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/yekanbakh</item>
        <item name="fontFamily">@font/yekanbakh</item>
        <item name="android:textColor">@color/nova_text</item>
    </style>

    <style name="Widget.Nova.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/yekanbakh</item>
        <item name="fontFamily">@font/yekanbakh</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">17sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/nova_primary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.Nova.Button.Secondary" parent="Widget.Nova.Button">
        <item name="backgroundTint">@color/nova_fill</item>
        <item name="android:textColor">@color/nova_text</item>
        <item name="rippleColor">#1A000000</item>
    </style>

    <style name="Widget.Nova.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/nova_surface</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/nova_muted</item>
        <item name="android:fontFamily">@font/yekanbakh</item>
        <item name="fontFamily">@font/yekanbakh</item>
    </style>

    <style name="Theme.NovaUpload.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:fontFamily">@font/yekanbakh</item>
        <item name="fontFamily">@font/yekanbakh</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Nova.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Nova.DialogButton</item>
    </style>

    <style name="Widget.Nova.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/yekanbakh</item>
        <item name="fontFamily">@font/yekanbakh</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nova_primary</item>
    </style>
</resources>
