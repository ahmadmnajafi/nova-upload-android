<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/bg_dialog"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yekanbakh"
        android:text="@string/dup_title"
        android:textColor="@color/nova_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/yekanbakh"
                android:text="@string/dup_new"
                android:textColor="@color/nova_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtNewCat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/yekanbakh"
                android:textColor="@color/nova_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/imgNew"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_preview"
                    android:contentDescription="@string/dup_new"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtNewEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/yekanbakh"
                    android:gravity="center"
                    android:text="@string/dup_empty"
                    android:textColor="@color/nova_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtNewName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/yekanbakh"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/nova_text"
                android:textDirection="ltr"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/yekanbakh"
                android:text="@string/dup_old"
                android:textColor="@color/nova_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtOldCat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/yekanbakh"
                android:textColor="@color/nova_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/imgOld"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_preview"
                    android:contentDescription="@string/dup_old"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtOldEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/yekanbakh"
                    android:gravity="center"
                    android:text="@string/dup_empty"
                    android:textColor="@color/nova_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtOldName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/yekanbakh"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/nova_text"
                android:textDirection="ltr"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccept"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="@string/dup_accept" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReject"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:fontFamily="@font/yekanbakh"
        android:text="@string/dup_reject"
        android:textAllCaps="false"
        android:textColor="@color/nova_danger"
        android:textSize="16sp" />
</LinearLayout>
